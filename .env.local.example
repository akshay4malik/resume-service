# =============================================================================
# AI Resume Builder — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Database + Auth)
# Get these from: https://app.supabase.com → Project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # server-only, never expose to client

# -----------------------------------------------------------------------------
# Cloudflare R2 (Object Storage — replaces Azure Blob)
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Endpoint format: https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=resume-service

# -----------------------------------------------------------------------------
# LLM Provider (choose one)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...                    # if using OpenAI
GOOGLE_GENERATIVE_AI_API_KEY=AIza...     # if using Gemini

# -----------------------------------------------------------------------------
# Razorpay (Payments)
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...  # safe to expose to client (public key only)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000  # update to your Vercel URL in production

